# Server-only public origin. Do not put secrets in NEXT_PUBLIC_* variables.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:65421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-local-or-hosted-secret-key
# Server-only, optional. HTTPS endpoint that receives contact and start-free
# requests as JSON. When empty, the forms say that nothing was sent.
LEAD_INTAKE_WEBHOOK_URL=
# Server-only. Signs widget tokens: "kid:base64url" pairs, newest first, comma
# separated, at least 32 random bytes each. Empty: the widget stays off.
WIDGET_TOKEN_SECRETS=
# Server-only. Header that the hosting platform overwrites with the client
# address. Required outside localhost; a header a client can set is not safe.
WIDGET_CLIENT_IP_HEADER=
# Server-only worker authentication. Use at least 32 random bytes.
INGESTION_WORKER_TOKEN=
# Server-only fail-closed malware scanner hook. The endpoint must return
# {"status":"clean"} or {"status":"infected"}.
INGESTION_MALWARE_SCANNER_URL=
INGESTION_MALWARE_SCANNER_TOKEN=
# Server-only embedding hook. It receives
# {"model":"...","dimensions":384,"input":["..."]} and returns
# {"embeddings":[[...384 finite numbers...]]}. HTTPS is required outside local.
EMBEDDING_PROVIDER_URL=
EMBEDDING_PROVIDER_TOKEN=
EMBEDDING_MODEL=
# Test builds only. Never set these in a deployed environment.
# CAEL_TEST_HARNESS=enabled compiles the /app/test-harness pages into a build.
# CAEL_NEXT_DIST_DIR=.next-check builds without touching a running dev server.
# Server-only LLM settings (P1.3). Provider/model change is config only; the
# provider name must match a registered adapter. Empty price => fail closed.
# Registered adapters: `demo` (P1.4; no network, no cost, answers only with
# approved source text). For the demo: LLM_PROVIDER=demo, LLM_MODEL=demo-1,
# LLM_PRICING_VERSION=demo-free and the three prices 0.
LLM_PROVIDER=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_ATTEMPTS=2
LLM_PER_CALL_MAX_COST_MICROS=50000
# Per organization per UTC day, micro-USD. 0 blocks every LLM call.
LLM_DAILY_BUDGET_MICROS=0
LLM_PRICING_VERSION=
LLM_PRICE_INPUT_MICROS_PER_MILLION=
LLM_PRICE_OUTPUT_MICROS_PER_MILLION=
LLM_PRICE_CACHED_INPUT_MICROS_PER_MILLION=
# Any value except off/false/0 stops all LLM calls (safe handoff text instead).
LLM_EMERGENCY_STOP=off
# Server-only P1.5 inbox e-mail outbox worker. The endpoint receives only the
# recipient address, template code and conversation UUID; transcript/PII is not sent.
INBOX_NOTIFICATION_WORKER_TOKEN=
INBOX_EMAIL_WEBHOOK_URL=
INBOX_EMAIL_WEBHOOK_TOKEN=
